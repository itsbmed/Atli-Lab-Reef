# public/.htaccess für Frontend und Backend in einem Ordner (deploy/build-release.ps1 legt sie ins Archiv).
# - api/, sanctum/ und up gehen an Laravel (index.php)
# - vorhandene Dateien (Vue-Build, Bilder) liefert Apache direkt aus
# - alle übrigen Pfade gehen an die Vue-App (index.html), damit z. B. /lab-test/dashboard auch beim Neuladen funktioniert

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Laravel: API, Sanctum und Health-Check
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:(?:api|sanctum)(?:/|$)|up$) index.php [L]

    # Fehlende Build-Dateien nicht als index.html ausliefern (sonst lädt der Browser HTML als JavaScript)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/ - [R=404,L]

    # Vue-App
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # index.html immer frisch laden, damit nach einem Update sofort die neue Version erscheint
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Build-Dateien tragen einen Hash im Namen und ändern sich nie
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
